# Copy to .env next to docker-compose.yml. Never commit the real file.

# Image tag to run. Pinned to a minor version: before 1.0, a minor release may change
# the config format. See CHANGELOG.md before raising it.
VEDETTE_VERSION=0.1

# NVD API key (free): https://nvd.nist.gov/developers/request-an-api-key
# Without one, NVD allows 5 requests per 30s and syncing is roughly ten times slower.
NVD_API_KEY=

# trace | debug | info | warn | error
VEDETTE_LOG=info

# Secrets referenced from config/vedette.toml. Set the ones your channels use.
# Compose interpolates ${...} inside values: write a literal $ as $$, or single-quote the value.
SMTP_PASSWORD=
# NTFY_TOKEN=
# TELEGRAM_BOT_TOKEN=
# GOTIFY_TOKEN=
# WEBHOOK_HMAC=

# Any config setting can be overridden here: VEDETTE_ prefix, `__` between levels.
# For example, if www.cisa.gov is blocked on your network, read KEV from CISA's GitHub copy:
# VEDETTE_KEV__URL=https://raw.githubusercontent.com/cisagov/kev-data/develop/known_exploited_vulnerabilities.json
